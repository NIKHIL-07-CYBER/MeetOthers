# MeshMeet Environment Variables
# Copy this file to .env.local and fill in the values
# DO NOT commit .env.local to git

# ─── TURN Server (for production WebRTC reliability) ─────────────────────────
# Sign up for free at https://xirsys.com to get these credentials.
# Without TURN, ~20-30% of P2P connections will fail (corporate firewalls, CGNAT).

# NEXT_PUBLIC_TURN_URL=turn:your-xirsys-host.turn.xirsys.com:3478
# NEXT_PUBLIC_TURN_USER=your-xirsys-username
# NEXT_PUBLIC_TURN_CRED=your-xirsys-credential
